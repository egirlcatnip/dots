//
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}",
      "key": " "
    },
    {
      "type": "separator",
      "times": 32
    },
    {
      "type": "host",
      "key": " ",
      "format": "{name}"
    },
    {
      "type": "os",
      "key": " ",
      "format": "{name} {version-id}"
    },
    {
      "type": "separator",
      "times": 32
    },
    {
      "type": "cpu",
      "key": " ",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": " ",
      "format": "{name}"
    },
    {
      "type": "separator",
      "times": 32
    },
    {
      "type": "colors",
      "block": {
        "width": 4
      }
    }
  ],
  "logo": {
    "type": "none"
  },
  "display": {
    "size": {
      "binaryPrefix": "si",
      "ndigits": 0
    },
    "hideCursor": true,
    "showErrors": true,
    "color": {
      "keys": "default",
      "title": "default"
    }
  }
}

